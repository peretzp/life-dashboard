# Copy this to `.env` on each fleet node (or export these in the node's
# service unit). `.env` is gitignored — never commit real tokens.

# Slack app-level token for Socket Mode — starts with xapp-
SLACK_APP_TOKEN=xapp-...

# Slack bot token for the Web API — starts with xoxb-
SLACK_BOT_TOKEN=xoxb-...

# Friendly name for THIS node (shown as the reply prefix). e.g. bork-oak / bork-fram
FLEET_NODE=bork-oak

# Optional: channel ID to announce presence on startup/shutdown (e.g. C0BQD1021FX)
FLEET_PRESENCE_CHANNEL=

# Optional: local command that answers prompts. The Slack message is passed as
# the FINAL argv element (never shell-interpolated → injection-safe). Examples:
#   FLEET_HANDLER_CMD=claude -p
#   FLEET_HANDLER_CMD=ollama run llama3.1
# Leave blank to run in safe echo mode (no model calls).
FLEET_HANDLER_CMD=

# Set to 1 to feed the prompt over stdin instead of as an argument.
FLEET_HANDLER_STDIN=

# Max ms to wait for the handler before killing it.
FLEET_HANDLER_TIMEOUT_MS=120000

# Optional: comma-separated channel IDs to restrict where the bridge responds.
# Reliable only with a per-node Slack app (see README → Topology).
FLEET_ALLOW_CHANNELS=
